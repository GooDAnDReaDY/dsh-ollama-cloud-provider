{
  "name": "@goodandready/dsh-ollama-cloud-provider",
  "version": "0.1.31",
  "description": "Ollama Cloud LLM provider plugin for DeepSeek Harness (dsh).",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "media/visual-verification.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GooDAnDReaDY/dsh-ollama-cloud-provider.git"
  },
  "bugs": {
    "url": "https://github.com/GooDAnDReaDY/dsh-ollama-cloud-provider/issues"
  },
  "homepage": "https://github.com/GooDAnDReaDY/dsh-ollama-cloud-provider#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.4": "compatible",
        "0.2.2-alpha.2": "compatible",
        "0.2.2-alpha.3": "compatible",
        "0.2.2-rc.1": "compatible"
      },
      "dsh": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown 1>&2",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/core.test.ts tests/usage.test.ts tests/adapter.test.ts tests/routes.test.ts tests/native.test.ts tests/openai-chat.test.ts tests/commands.test.ts tests/tui-settings.test.ts tests/analytics.test.ts tests/apply.test.ts tests/account-rules.test.ts tests/request-log.test.ts tests/image-budget.test.ts tests/tool-schema.test.ts tests/tools.test.ts tests/plugin-updater.test.ts tests/compat.test.ts tests/status.test.ts tests/settings-draft.test.ts tests/update-state.test.ts tests/ui-render.test.tsx tests/update-card-view.test.tsx tests/web.test.ts tests/mock-ollama.test.ts tests/reasoning.test.ts tests/catalog-cache.test.ts tests/attempt.test.ts tests/model-groups.test.tsx tests/discovery.test.ts tests/sanitize.test.ts tests/retry.test.ts tests/provider-card.test.tsx tests/host-verification.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "release": "npm run check && npm pack",
    "sync:models": "node scripts/sync-models.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ollama",
    "ollama-cloud",
    "llm-provider"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.5 || ~4.0.6-alpha.1 || ~4.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5 || ~3.18.6-alpha.1 || ~3.19.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "18.3.7",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
